# Copy this file to .env.local and fill in the two values below.
#
# NEXT_PUBLIC_SUPABASE_URL is your project's API URL. For fleet-rental-os
# this is:
#   https://rfrqvurreiuavuvoofiy.supabase.co
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY: I could not fetch this automatically this
# session (a tool error on my end, not a problem with your project). Get it
# from: Supabase Dashboard -> fleet-rental-os -> Project Settings -> API
# -> "anon" / "publishable" key. It is safe to expose in browser code (that's
# what NEXT_PUBLIC_ means) as long as your RLS policies are correct, which
# they are per migrations 0014-0017.
#
# NEVER put the service_role key in this file or anywhere with a
# NEXT_PUBLIC_ prefix. It bypasses RLS entirely and must only ever be used
# in server-side code you control directly (and ideally not even there for
# this app, since RLS is designed to do this job).

NEXT_PUBLIC_SUPABASE_URL=https://rfrqvurreiuavuvoofiy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-key-here
